# FunPay: Golden Key из настроек аккаунта
GOLDEN_KEY=your_key_here

# Google Drive: ID папки, куда складывать гайды
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# ─── ИИ через свой Cloudflare Worker (см. README.md) ─────────────────────
# Рабочая модель — Gemini. Вызов идёт через твой Worker по HTTP:
# Gemini SDK в боте не нужен, ключ лежит в секретах Worker'а.
# Адрес Worker'а (без слэша на конце)
AI_WORKER_URL=https://ai-worker.твой-логин.workers.dev
# Пароль между ботом и Worker'ом (секрет PROXY_TOKEN внутри Worker'а)
AI_WORKER_TOKEN=your_worker_token_here
# Основная модель. Если она ответит лимитом (429), перегрузится (503) или
# не успеет за таймаут, бот сам перейдёт к следующей модели из цепочки —
# сначала к резервным Gemini, затем к бесплатным моделям Cloudflare.
AI_MODEL_PRIORITY=gemini-3.6-flash
# Бесплатные модели Cloudflare Workers AI — последний рубеж, когда все
# Gemini кончились. Ключи не нужны, работают на том же Worker'е.
# Через запятую; off — отключить.
# AI_CLOUDFLARE_MODELS=@cf/openai/gpt-oss-120b,@cf/qwen/qwen3-30b-a3b-fp8,@cf/openai/gpt-oss-20b
# Таймаут одного запроса к ИИ, секунды (необязательно)
AI_TIMEOUT=180
# Подробный вывод в консоль: модели, тайминги, токены, уровни сокращения summary.
# Без этой переменной в консоли только короткий итог по товару,
# а всё остальное пишется в logs/ai_usage.jsonl и logs/errors.log.
# DEBUG_LOGS=1

# ─── Прокси (необязательно) ───────────────────────────────────────────────
# Нужен, только если FunPay или Worker перестанут открываться напрямую.
# Формат: http://логин:пароль@адрес:порт
# PROXY_URL=
# Отдельный прокси только для ИИ. Важнее PROXY_URL, потому что провайдеры
# часто блокируют *.workers.dev по имени хоста, а FunPay при этом открыт.
# AI_PROXY_URL=
# Бесплатный резерв, если Worker заблокирован: ключ Gemini из AI Studio.
# Бот спросит Gemini напрямую, минуя Worker. Ключ тот же, что в секретах Worker'а.
# GEMINI_API_KEY=

# ─── Оформление заголовков витрины ─────────────────────────────────────────
# У каждой категории товаров свой стиль. Допустимые значения:
# fox, clover, swan, crystal, mage, plane, mod, hwid.
# По умолчанию: гайды — fox, ПК — swan, сеть — crystal,
# мод-меню — mod, блокировки — hwid.
# TITLE_STYLE_GUIDE=fox
# TITLE_STYLE_PC=swan
# TITLE_STYLE_NET=crystal
# TITLE_STYLE_MOD=mod
# TITLE_STYLE_HWID=hwid
